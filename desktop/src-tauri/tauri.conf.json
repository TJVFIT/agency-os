{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agency OS",
  "version": "0.1.0",
  "identifier": "com.agencyos.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agency OS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
