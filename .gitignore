# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any package in the workspace)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values; the template must stay tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client setup package binaries (installer is regenerated via desktop build)
dist-client/*.exe
dist-client/*.zip
AgencyOS-Client-Setup.zip
