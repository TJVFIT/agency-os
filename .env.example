# ===== Agency OS environment =====
# Copy to .env.local (app) and worker/.env (worker). Never commit real values.

# --- Part A: core ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server + worker only
APP_URL=http://localhost:3000         # public URL in prod (approval links)

# AI providers (free tiers)
GEMINI_KEY_A=                         # Google project 1: caption/reply/plan/report
GEMINI_KEY_B=                         # Google project 2: translation
GEMINI_MODEL=gemini-flash-latest      # keep current; Flash/Flash-Lite are the free models
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=                           # current free Llama model id
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                     # a current ":free" model id
DEEPL_API_KEY=                        # optional (API Free tier)

# --- Part B: media + bot ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agency-media
R2_PUBLIC_BASE_URL=                   # https://media.example.com or r2.dev URL
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=       # same value as R2_PUBLIC_BASE_URL (browser needs it for /assets thumbnails)
TELEGRAM_BOT_TOKEN=

# --- Dev tooling (not shipped in the product) ---
API_KEY_21ST=                         # 21st.dev Magic MCP key, https://21st.dev/magic/console

# --- Part C: publishing + ops ---
POSTIZ_URL=                           # http://postiz:5000 inside Coolify network
POSTIZ_API_KEY=
WHISPER_MODEL=small                   # small|base ; int8 on CPU
TZ=Europe/Istanbul

# --- Part D: v2 (UPGRADE_SPEC.md) ---
# Web push — generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # worker only
VAPID_SUBJECT=mailto:you@agency.com
# Optional poster (afiş) image provider — Gemini free tier is the default
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# --- ops / dev (optional) ---
LOG_LEVEL=info                        # worker pino level
SUPABASE_DB_URL=                      # postgres URL for nightly pg_dump backup
SEED_ADMIN_EMAIL=                     # used by `pnpm seed:admin` (or pass --email)
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
