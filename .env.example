# ===== Agency OS environment =====
# Copy to .env.local (app) and worker/.env (worker). Never commit real values.

# --- Part A: core ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server + worker only
APP_URL=http://localhost:3000         # public URL in prod (approval links)

# AI providers (free tiers)
GEMINI_KEY_A=                         # Google project 1: caption/reply/plan/report
GEMINI_KEY_B=                         # Google project 2: translation
GEMINI_MODEL=gemini-flash-latest      # keep current; Flash/Flash-Lite are the free models
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=                           # current free Llama model id
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                     # a current ":free" model id
DEEPL_API_KEY=                        # optional (API Free tier)

# --- Part B: media + bot ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agency-media
R2_PUBLIC_BASE_URL=                   # https://media.example.com or r2.dev URL
TELEGRAM_BOT_TOKEN=

# --- Part C: publishing + ops ---
POSTIZ_URL=                           # http://postiz:5000 inside Coolify network
POSTIZ_API_KEY=
WHISPER_MODEL=small                   # small|base ; int8 on CPU
TZ=Europe/Istanbul
